@@ -98,3 +104,39 @@ def s2_title_search(
     except Exception as e:
         print(f"      ⚠️ S2 Error for '{title_query}': {e}")
         return None
+
+def _crossref_search(title_query: str, rows: int = 10, year_hint: int = None) -> list:
+    """Crossref fallback returning records in Semantic Scholar's field layout."""
+    import re as _re
+    try:
+        params = {"query.bibliographic": title_query, "rows": rows,
+                  "select": "title,author,issued,container-title,abstract,is-referenced-by-count,DOI"}
+        if year_hint:
+            params["filter"] = f"from-pub-date:{year_hint - 1},until-pub-date:{year_hint + 1}"
+        r = requests.get(
+            "https://api.crossref.org/works",
+            params=params,
+            headers={"User-Agent": "paper-orchestra-crossref-fallback/0.1"},
+            timeout=30,
+        )
+        if r.status_code != 200:
+            return []
+        out = []
+        for it in r.json().get("message", {}).get("items", []):
+            title = (it.get("title") or [""])[0]
+            parts = (it.get("issued", {}).get("date-parts") or [[None]])[0]
+            year = parts[0] if parts else None
+            pdate = "-".join(f"{v:02d}" if i else str(v) for i, v in enumerate(parts)) if len(parts) == 3 else None
+            venue = (it.get("container-title") or [""])[0]
+            abstract = _re.sub(r"<[^>]+>", " ", it.get("abstract") or "")
+            abstract = " ".join(abstract.split())
+            authors = [{"name": " ".join(x for x in (a.get("given"), a.get("family")) if x)}
+                       for a in it.get("author", [])]
+            out.append({"title": title, "authors": authors, "venue": venue, "year": year,
+                        "abstract": abstract, "citationCount": it.get("is-referenced-by-count", 0),
+                        "journal": {"name": venue}, "publicationDate": pdate,
+                        "externalIds": {"DOI": it.get("DOI")}})
+        return out
+    except Exception as e:
+        print(f"      ⚠️ Crossref Error for '{title_query}': {e}")
+        return []
